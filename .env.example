# Nenhum segredo deve ser prefixado com VITE_. O modo padrão não coleta dados.
CONTRACTING_ENABLED=false
PUBLIC_ORIGIN=https://SEU-DOMINIO-VALIDADO
HOST=127.0.0.1
PORT=8787
# Rascunho comercial está exclusivamente em business.json. Informe aqui só o valor aprovado em centavos.
APPROVED_PRICE_CENTS=
LEGAL_VERSION=
LEGAL_NAME=
CNPJ=
SERVICE_CONDITIONS=
PRIVACY_NOTICE=
RETENTION_DAYS=
# Chave base64 de 32 bytes, fornecida pelo gerenciador de segredos. Não versionar.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=
# Adaptador privado do provedor brasileiro escolhido pelo cliente.
PAYMENT_BRIDGE_URL=
PAYMENT_BRIDGE_TOKEN=
CHECKOUT_ALLOWED_HOSTS=
WEBHOOK_SECRET=
SUPPORT_WHATSAPP=
# Só necessário se o frontend e a API estiverem em origens diferentes.
VITE_API_BASE_URL=
